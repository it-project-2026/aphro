# AI Studio / Gemini
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
APP_URL="YOUR_APP_URL"

# APHRO HyperCloudHost PostgreSQL
# Use the real production DATABASE_URL only in the server environment/cPanel.
HYPERCLOUD_DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require"

# JWT signing secret - generate a random value of at least 32 characters.
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS"

# Frontend API endpoint
VITE_API_URL="https://api.aphro-row.my.id"
